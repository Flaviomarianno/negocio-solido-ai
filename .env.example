# Copie para .env.local e preencha. NUNCA commite o .env.local (já está no .gitignore).

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Webhook de leads (/api/leads/webhook) ---
# Se vazio, o endpoint aceita chamadas sem autenticação — só para dev local.
# Preencha antes de expor o painel publicamente e envie o mesmo valor no
# header "x-webhook-secret" de quem chamar o endpoint.
LEADS_WEBHOOK_SECRET=

# --- Asaas ---
ASAAS_API_KEY=
ASAAS_ENV=sandbox   # trocar para "production" quando for para o ar
# Token de autenticação do webhook (/api/webhooks/asaas). Gere um valor longo e
# aleatório e cadastre o MESMO valor no painel do Asaas. Sem ele o endpoint recusa tudo.
ASAAS_WEBHOOK_TOKEN=

# --- Meta (WhatsApp Cloud API + Instagram Graph API) ---
META_APP_ID=
META_APP_SECRET=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_IG_BUSINESS_ACCOUNT_ID=
META_WEBHOOK_VERIFY_TOKEN=

# --- HeyGen (avatar) ---
HEYGEN_API_KEY=

# --- ElevenLabs (voz) ---
ELEVENLABS_API_KEY=

# --- Resend (e-mail) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=          # remetente; em teste use onboarding@resend.dev
DIAGNOSTICO_NOTIFY_EMAIL=   # e-mail do Flávio: recebe cópia de cada agendamento
APP_URL=http://localhost:3000   # URL pública do painel, usada nos links dos e-mails

# --- Inngest ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
