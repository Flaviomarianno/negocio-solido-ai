# Variáveis de ambiente do painel (Vercel). Cole os NOMES abaixo no painel da
# Vercel (Project Settings > Environment Variables) e preencha os valores lá —
# nunca neste arquivo, que fica versionado no git.

# =====================================================================
# OBRIGATÓRIAS — sem elas o painel nem abre (erro ao logar / carregar dados)
# =====================================================================

# URL do projeto Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública do Supabase — usada só para login (nunca lê/escreve dados direto)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta do Supabase — acesso total, usada só no servidor. NUNCA expor ao browser.
SUPABASE_SERVICE_ROLE_KEY=

# =====================================================================
# POR FUNCIONALIDADE — o painel sobe sem elas, mas a funcionalidade correspondente falha até serem preenchidas
# =====================================================================

# --- Motor de agentes (Ag09/10/11, fila de aprovação) ---
# Chave da Claude API (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=
# Chaves do app no Inngest Cloud (app.inngest.com > seu app > "Event Keys" / "Signing Keys")
# NÃO defina INNGEST_DEV em produção — essa variável é só para o Inngest Dev Server local.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Checkout do diagnóstico R$ 97 (Asaas) ---
# Chave da API do Asaas (sandbox ou produção, conforme ASAAS_ENV)
ASAAS_API_KEY=
# "sandbox" ou "production" — manter "sandbox" nesta primeira publicação
ASAAS_ENV=sandbox
# Token que você escolhe e cadastra igual no painel do Asaas (Webhooks > Token de autenticação);
# o endpoint /api/webhooks/asaas recusa (401) qualquer chamada sem esse token exato
ASAAS_WEBHOOK_TOKEN=

# --- E-mails de confirmação (Resend) ---
# Chave da API do Resend (resend.com > API Keys)
RESEND_API_KEY=
# Remetente dos e-mails — precisa ser de um domínio verificado no Resend (resend.com/domains)
RESEND_FROM_EMAIL=
# Seu e-mail — recebe cópia de cada diagnóstico agendado
DIAGNOSTICO_NOTIFY_EMAIL=

# --- Geral ---
# URL pública do painel já publicado (ex.: https://negocio-solido-ai.vercel.app), sem barra no final —
# usada para montar os links absolutos dentro dos e-mails
APP_URL=

# =====================================================================
# OPCIONAL
# =====================================================================

# Se preenchida, POST /api/leads/webhook passa a exigir esse valor no header
# x-webhook-secret. Se vazia, o endpoint aceita chamadas sem autenticação —
# recomendado preencher antes de divulgar essa URL publicamente.
LEADS_WEBHOOK_SECRET=
